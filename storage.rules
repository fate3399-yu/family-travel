rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 只有已登入的使用者可以讀寫收據與旅遊照片
    match /{allPaths=**} {
      allow read: if request.auth != null;
      // 限制只能上傳圖片且檔案大小小於 5MB
      allow write: if request.auth != null
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
