rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 檢查是否為已登入使用者
    function isAuthenticated() {
      return request.auth != null;
    }

    // 檢查是否為本人
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. 使用者個人資料 (users/{userId})：僅本人可讀寫
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. 家庭本體 (families/{familyId})
    match /families/{familyId} {
      // 讀取：必須是家庭成員或建立者
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.creatorUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );

      // 建立：建立者必須為登入者本人
      allow create: if isAuthenticated() &&
        request.resource.data.creatorUid == request.auth.uid;

      // 更新：家庭成員可更新，或受邀者加入時更新 memberUids
      allow update: if isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        (request.resource.data.memberUids != null && request.resource.data.memberUids.hasAny([request.auth.uid]))
      );

      // 刪除：僅建立者本人可刪除家庭
      allow delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;

      // 2.1 成員名單 (members/{memberId})
      match /members/{memberId} {
        allow read, write: if isAuthenticated();
      }

      // 2.2 安全邀請函 (invitations/{token})
      match /invitations/{inviteToken} {
        allow read, write: if isAuthenticated();
      }

      // 2.3 旅程帳本 (trips/{tripId})
      match /trips/{tripId} {
        allow read, write: if isAuthenticated();

        // 2.4 支出交易與明細 (transactions/{txId})
        match /transactions/{txId} {
          allow read, write: if isAuthenticated();
        }
      }
    }
  }
}
